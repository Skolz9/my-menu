# ============================================================================
# MY MENU — SUPABASE CONFIGURATION (Frontend Public Keys Only)
# ============================================================================
# Copy this file to .env.local and fill in your Supabase project credentials.
# SECURITY WARNING: NEVER put your Supabase service_role key in the frontend!
# Only use the public anon key (Row Level Security & SECURITY DEFINER RPCs protect data).
# When these variables are omitted, the app automatically runs with the offline
# demo fallback (src/menus/demo.ts) so /m/demo and the demo dashboard still work.

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# Optional deployed site base URL used for canonical links and QR code generation
VITE_BASE_URL="https://mymenu.ma"

